# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The publishable "anon" key. Safe in the browser BY DESIGN — it is in the JS
# bundle. It is only safe because Row Level Security constrains what it can do,
# so never disable RLS on a table this key can reach.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key bypasses RLS entirely. Server-side only.
# NEVER prefix it with NEXT_PUBLIC_ and never import it into a client component.
# REQUIRED for the Razorpay webhook: it arrives with no user session and has to
# move a booking to confirmed. Nothing else in the app may use it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL. Without it, canonical tags, the sitemap and OpenGraph all
# point at the placeholder domain in lib/seo.ts.
NEXT_PUBLIC_SITE_URL=https://korahouse.com

# --------------------------------------------------------------- Razorpay ---
#
# All three are server-only. None may ever carry a NEXT_PUBLIC_ prefix: the key
# secret signs payment requests and the webhook secret authenticates incoming
# payment events, so either one in the browser bundle is a total compromise.
#
# Leave them unset and the site still works — accepting a request holds the
# room and the host sends payment details themselves. Payment links appear the
# moment the keys are added; nothing else changes.
#
# Razorpay Dashboard → Settings → API Keys
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-key-secret
#
# Razorpay Dashboard → Settings → Webhooks. Point it at
#   https://your-domain/api/razorpay/webhook
# and subscribe to payment_link.paid, payment.captured and payment.failed.
# This secret is chosen by you when creating the webhook, not issued by them.
# RAZORPAY_WEBHOOK_SECRET=a-long-random-string-you-choose
